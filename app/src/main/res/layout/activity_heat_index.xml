<?xml version="1.0" encoding="utf-8"?>
<erg.com.nioshheatindex.Zoomlayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/zoomLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:background="@color/surface"
    tools:context="erg.com.nioshheatindex.HeatIndexActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/heatHeaderBackground"
            android:layout_width="0dp"
            android:layout_height="132dp"
            android:background="@drawable/header_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewHeatIndexTopPic"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="@string/hi_banner_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/heatindex"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/imageViewTextHeatIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="30dp"
            android:text="@string/hi_banner_text"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/heatHeaderBackground"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/heatHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="14dp"
            android:text="Current conditions and heat risk"
            android:textColor="#BCE7E7"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/heatHeaderBackground"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/txttutorial"
            android:padding="8dp"
            android:src="@drawable/helpbutton"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/heatHeaderBackground"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnReminders"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/txtreminders"
            android:padding="8dp"
            android:src="@drawable/reminder_button"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/heatHeaderBackground"
            app:layout_constraintEnd_toStartOf="@id/btnHome" />

        <EditText
            android:id="@+id/location"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/input_background"
            android:drawableStart="@drawable/geo"
            android:hint="@string/hint_location_edittext"
            android:imeOptions="actionGo"
            android:inputType="textPostalAddress"
            android:padding="12dp"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heatHeaderBackground"
            tools:ignore="Autofill" />

        <TextView
            android:id="@+id/conditionsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Optional: enter conditions manually"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/location"
            app:layout_constraintTop_toBottomOf="@id/location" />

        <EditText
            android:id="@+id/temp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/input_background"
            android:drawableStart="@drawable/temp"
            android:hint="@string/txtTemperature"
            android:inputType="phone"
            android:padding="12dp"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@id/humidity"
            app:layout_constraintStart_toStartOf="@id/location"
            app:layout_constraintTop_toBottomOf="@id/conditionsLabel"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/humidity"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:drawableStart="@drawable/humidity"
            android:hint="@string/txtHumidity"
            android:inputType="number"
            android:padding="12dp"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="@id/location"
            app:layout_constraintStart_toEndOf="@id/temp"
            app:layout_constraintTop_toBottomOf="@id/conditionsLabel"
            tools:ignore="Autofill" />

        <view
            android:id="@+id/view"
            class="erg.com.nioshheatindex.GaugeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/heat_index_gauge"
            android:onClick="refreshActivity"
            app:feelsLikeTemp="--"
            app:layout_constraintBottom_toTopOf="@id/btnAP"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/temp"
            app:needle="0"
            app:spanish="false"
            app:time="--" />

        <Button
            android:id="@+id/btnAP"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_primary"
            android:contentDescription="@string/multipurposebtn_desc"
            android:text="@string/hi_allpurpose_btn_minrisk"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvMainText"
            app:layout_constraintEnd_toEndOf="@id/view"
            app:layout_constraintStart_toStartOf="@id/view" />

        <TextView
            android:id="@+id/tvMainText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/include"
            app:layout_constraintEnd_toEndOf="@id/view"
            app:layout_constraintStart_toStartOf="@id/view" />

        <include
            android:id="@+id/include"
            layout="@layout/nav_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnUseCurrent"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@color/brandDark"
            android:text="@string/label_usecurrent_btn"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/include"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</erg.com.nioshheatindex.Zoomlayout>
